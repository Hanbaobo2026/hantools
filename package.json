{
  "name": "hantools",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "HanTools — 面向 CTF 与日常开发的本地优先在线工具集",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:site && npm run build:offline",
    "build:site": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "build:offline": "vite build --config vite.config.offline.ts && node scripts/inline-offline.mjs",
    "build:all": "npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .wrangler-dry"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "crypto-js": "^4.2.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
